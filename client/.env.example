# ── REQUIRED ───────────────────────────────────────────────────────────────────

# Pinata IPFS credentials
# Note: PINATA_API_KEY (no NEXT_PUBLIC_) keeps keys server-side via /api/pin
PINATA_API_KEY=
PINATA_API_SECRET_KEY=

# Smart contract address (deployed on Polygon Amoy Testnet, chainId 80002)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ── OPTIONAL ───────────────────────────────────────────────────────────────────

# The Graph subgraph URL (fallback to direct contract call if not set)
NEXT_PUBLIC_API_URL=

# ── RAZORPAY (INR Payments) ────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/ → Settings → API Keys
# Use Test Mode keys for development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── CRYPTO PAYMENTS ────────────────────────────────────────────────────────────
# Wallet address that receives MATIC subscription payments
NEXT_PUBLIC_PAYMENT_RECEIVER_ADDRESS=0xAA620c50359e6ee40cFCb7F0b587c6dB9FE97C96